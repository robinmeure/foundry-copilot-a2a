              "CopilotStudio__Cloud": "Prod",
              "CopilotStudio__DefaultAgent": "orchestrator",
              "CopilotStudio__Agents__orchestrator__DisplayName": "Orchestrator",
              "CopilotStudio__Agents__orchestrator__DirectConnectUrl": "[format('@Microsoft.KeyVault(SecretUri={0}/orchestrator-direct-connect-url)', variables('keyVaultSecretBaseUrl'))]",
              "CopilotStudio__Agents__tweede_kamer_classic__Id": "tweede-kamer-classic",
              "CopilotStudio__Agents__tweede_kamer_classic__DisplayName": "Tweede Kamer Classic",
              "CopilotStudio__Agents__tweede_kamer_classic__DirectConnectUrl": "[format('@Microsoft.KeyVault(SecretUri={0}/tweede-kamer-classic-direct-connect-url)', variables('keyVaultSecretBaseUrl'))]",
              "OTEL_SERVICE_NAME": "[parameters('webAppName')]",
              "OTEL_RESOURCE_ATTRIBUTES": "[format('deployment.environment={0},service.namespace=foundry-copilot-a2a', parameters('environmentName'))]"
            },
            "appSettings": "[union(variables('baseAppSettings'), variables('originAppSettings'))]"
          },
          "resources": [
            {
              "type": "Microsoft.Web/serverfarms",
              "apiVersion": "2024-04-01",
              "name": "[parameters('appServicePlanName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": {
                "name": "[parameters('appServicePlanSku')]"
              },
              "kind": "linux",
              "properties": {
                "reserved": true
              }
            },
            {
              "type": "Microsoft.Web/sites",
              "apiVersion": "2024-04-01",
              "name": "[parameters('webAppName')]",
              "location": "[parameters('location')]",
              "tags": "[union(parameters('tags'), createObject('azd-service-name', 'handler'))]",
              "kind": "app,linux",
              "identity": {
                "type": "UserAssigned",
                "userAssignedIdentities": {
                  "[format('{0}', parameters('identityId'))]": {}
                }
              },
              "properties": {
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
                "httpsOnly": true,
                "keyVaultReferenceIdentity": "[parameters('identityId')]",
                "clientAffinityEnabled": false,
                "siteConfig": {
                  "copy": [
                    {
                      "name": "appSettings",
                      "count": "[length(items(variables('appSettings')))]",
                      "input": {
                        "name": "[items(variables('appSettings'))[copyIndex('appSettings')].key]",
                        "value": "[items(variables('appSettings'))[copyIndex('appSettings')].value]"
                      }
                    }
                  ],
                  "linuxFxVersion": "[parameters('linuxFxVersion')]",
                  "alwaysOn": true,
                  "http20Enabled": true,
                  "minTlsVersion": "1.2",
                  "ftpsState": "Disabled",
                  "healthCheckPath": "/health"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]"
              ]
            }
          ],
          "outputs": {
            "webAppId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
            },
            "webAppName": {
              "type": "string",
              "value": "[parameters('webAppName')]"
            },
            "webAppDefaultHostName": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2024-04-01').defaultHostName]"
            },
            "handlerBackendUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2024-04-01').defaultHostName)]"
            },
            "appServicePlanId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "handlerFoundation",
        "monitoring",
        "resourceGroup"
      ]
    }
  },
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[parameters('resourceGroupName')]"
    },
    "apimName": {
      "type": "string",
      "value": "[reference('hubFoundation').outputs.apimName.value]"
    },
    "apimId": {
      "type": "string",
      "value": "[reference('hubFoundation').outputs.apimId.value]"
    },
    "apimPrincipalId": {
      "type": "string",
      "value": "[reference('hubFoundation').outputs.apimPrincipalId.value]"
    },
    "apimGatewayUrl": {
      "type": "string",
      "value": "[reference('hubFoundation').outputs.gatewayUrl.value]"
    },
    "hubApiBaseUrl": {
      "type": "string",
      "value": "[variables('gatewayBaseUrl')]"
    },
    "handlerBackendUrl": {
      "type": "string",
      "value": "[reference('handlerHosting').outputs.handlerBackendUrl.value]"
    },
    "handlerWebAppName": {
      "type": "string",
      "value": "[reference('handlerHosting').outputs.webAppName.value]"
    },
    "handlerIdentityClientId": {
      "type": "string",
      "value": "[reference('handlerFoundation').outputs.identityClientId.value]"
    },
    "handlerIdentityPrincipalId": {
      "type": "string",
      "value": "[reference('handlerFoundation').outputs.identityPrincipalId.value]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[reference('handlerFoundation').outputs.keyVaultName.value]"
    },
    "applicationInsightsResourceId": {
      "type": "string",
      "value": "[reference('monitoring').outputs.appInsightsId.value]"
    }
  }
}
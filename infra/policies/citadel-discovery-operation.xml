<policies>
  <inbound>
    <cors allow-credentials="false" terminate-unmatched-request="true">
      <allowed-origins>
        <origin>*</origin>
      </allowed-origins>
      <allowed-methods preflight-result-max-age="300">
        <method>GET</method>
      </allowed-methods>
      <allowed-headers>
        <header>Content-Type</header>
        <header>A2A-Version</header>
      </allowed-headers>
    </cors>
    <base />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>

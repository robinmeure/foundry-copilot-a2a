<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AGUI.Abstractions" Version="1.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.17.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.26.0" />
    <PackageReference Include="Microsoft.Agents.AI.A2A" Version="1.26.0-preview.261023.1" />
    <PackageReference Include="Microsoft.Graph" Version="6.9.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.88.0" />
    <ProjectReference Include="..\FoundryCopilotA2A.ServiceDefaults\FoundryCopilotA2A.ServiceDefaults.csproj" />
    <ProjectReference Include="..\FoundryCopilotA2A.Skills\FoundryCopilotA2A.Skills.csproj" />
    <!-- Skill folders ship with the API; Skills:Paths can add administrator-managed folders. -->
    <Content Include="..\..\skills\**" LinkBase="skills" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
